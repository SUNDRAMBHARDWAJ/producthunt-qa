# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Do not commit .env — it is gitignored. Secrets stay on your machine.

# --- API (GraphQL) ---
# Developer token from https://www.producthunt.com/v2/oauth/applications
# Without this, posts/limits API tests skip. Auth/transport/security tests still run.
PH_API_TOKEN=your_product_hunt_developer_token_here

PH_API_URL=https://api.producthunt.com/v2/api/graphql
PH_WEB_URL=https://www.producthunt.com

# Per-request timeout for API calls, in milliseconds.
PH_REQUEST_TIMEOUT_MS=15000

# --- E2E Google login (optional) ---
# Used only by the Playwright project named "login".
# If these are empty, login is recorded as FAILED in the HTML report and the
# rest of the UI tests still run logged out.
PH_GOOGLE_EMAIL=you@example.com
PH_GOOGLE_PASSWORD=your_google_password_here

# --- E2E browser (optional) ---
# true = real headless. Product Hunt's Cloudflare usually blocks this.
PH_HEADLESS=false
# chrome = installed Google Chrome (default). chromium = Playwright's browser.
PH_BROWSER_CHANNEL=chrome
